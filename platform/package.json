{
  "name": "platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "build:web": "npm run build --workspace @platform/web",
    "test": "vitest run",
    "test:seed": "node --test scripts/seed-test-accounts/season.test.mjs scripts/seed-test-accounts/preflight.test.mjs scripts/automation-access.test.mjs",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace @platform/web",
    "start": "npm run start --workspace @platform/web",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "eval": "tsx packages/eval/src/cli.ts",
    "seed": "tsx packages/db/src/seed.ts",
    "research": "tsx packages/research/src/cli.ts",
    "qa": "npm --prefix scripts/qa-agent run qa",
    "qa:headed": "npm --prefix scripts/qa-agent run qa:headed",
    "launch-review": "npm --prefix scripts/launch-review run review",
    "security-review": "npm --prefix scripts/security-review run security",
    "verify": "npm run test && npm run test:seed && npm run eval && npm run build:web"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "vite": {
      "esbuild": "^0.28.1"
    }
  }
}
