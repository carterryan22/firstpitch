# First Pitch — environment variables.
# Copy to .env.local (gitignored) for local dev, and set the same keys in the
# Vercel project (Settings → Environment Variables) for production.
#
# The web app reads ONLY the variables below — there is no Postgres/Prisma or
# NextAuth in the runtime path (the @platform/db Prisma package is unused by
# apps/web). Storage + auth + email are resolved from these env vars.

# ── Required in production ───────────────────────────────────────────

# HMAC secret for session cookies + Press Box share signatures.
# Auth REFUSES TO BOOT in production without it. Generate 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_AUTH_SECRET=

# Persistence. Without a store configured the app falls back to InMemoryStore,
# which loses ALL data between serverless invocations on Vercel. Provision
# Vercel KV / Upstash Redis and set BOTH keys (precedence #1):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Local-only alternative (precedence #2): a writable dir for a JSON file store.
# Do NOT point this under OneDrive (atomic-rename EPERM). Leave unset on Vercel.
# PLATFORM_DATA_DIR=

# Transactional email (magic-link sign-in). Without these, sign-in links are
# only printed to the server log and nobody can actually log in.
RESEND_API_KEY=
EMAIL_FROM=First Pitch <noreply@firstpitch.app>

# Local development only: explicitly allow printing and returning sign-in links.
# Ignored in production even if set. Never enable in a shared environment.
PLATFORM_ALLOW_DEV_EMAIL=0

# Canonical public origin (metadataBase, sitemap, robots, email links).
# Auto-detects from VERCEL_PROJECT_PRODUCTION_URL on Vercel; set to pin it.
NEXT_PUBLIC_SITE_URL=

# ── Recommended ────────────────────────────────────────────────

# Shared secret for the digest cron (/api/cron/digest). In production an UNSET
# secret now fails CLOSED, so set this if you schedule the digest.
CRON_SECRET=

# Where account-deletion / privacy (DSR) requests are emailed.
PRIVACY_INBOX=privacy@firstpitch.app

# ── Optional ───────────────────────────────────────────────────

# AI features (coach chat, intent search). Falls back to the deterministic
# MockProvider when unset.
OPENAI_API_KEY=

# Error monitoring. Set ONE to enable remote reporting (else dev-mode logs).
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# Billing (off by default — every team is free until STRIPE_SECRET_KEY is set).
STRIPE_SECRET_KEY=
STRIPE_PRICE_COACH=
STRIPE_PRICE_MULTI=
STRIPE_PRICE_CLUB=

# Privacy-friendly analytics (Plausible-compatible). Off unless domain is set.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io

# Affiliate tag for the gear catalog buy-links.
NEXT_PUBLIC_AFFILIATE_AMAZON_TAG=firstpitch-20

# Menu feature flags. Gear / Fields / Safety are temporarily hidden from the
# nav; the pages stay reachable by direct URL. Set a flag to "1" (or "true") to
# show that item in the menu again.
NEXT_PUBLIC_FEATURE_GEAR=
NEXT_PUBLIC_FEATURE_FIELDS=
NEXT_PUBLIC_FEATURE_SAFETY=
