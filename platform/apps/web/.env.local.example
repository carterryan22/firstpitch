# Copy this to .env.local and fill in real values.
# .env.local is gitignored. Push to Vercel with:
#   pnpm --filter web exec vercel link
#   ../../scripts/sync-env-to-vercel.ps1

DATABASE_URL=postgresql://user:pass@host:5432/db
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
# Stripe Price IDs per plan (only needed once billing is turned on)
STRIPE_PRICE_COACH=
STRIPE_PRICE_MULTI=
STRIPE_PRICE_CLUB=

# Public site URL (overrides Vercel auto-detection)
NEXT_PUBLIC_SITE_URL=

# Error monitoring (optional). Set ONE of these to enable remote reporting.
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# Where account-deletion / privacy requests are emailed.
PRIVACY_INBOX=privacy@firstpitch.app