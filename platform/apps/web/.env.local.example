# Copy this to .env.local (gitignored) and fill in real values.
# Mirror the same keys into the Vercel project for production.
# Canonical reference with all keys + notes: ../../.env.example

# ── Required in production ───────────────────────────────────────────────────
# HMAC secret for sessions + share signatures. Auth refuses to boot in prod
# without it. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_AUTH_SECRET=

# Persistence (Vercel KV / Upstash). Without these the app uses InMemoryStore
# and loses all data between serverless invocations. Set BOTH.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Magic-link email. Without these, sign-in links only print to the server log.
RESEND_API_KEY=
EMAIL_FROM=First Pitch <noreply@firstpitch.app>

# Public site URL (overrides Vercel auto-detection).
NEXT_PUBLIC_SITE_URL=

# ── Recommended ──────────────────────────────────────────────────────────────
# Digest cron auth — fails CLOSED in production when unset.
CRON_SECRET=
# Where account-deletion / privacy requests are emailed.
PRIVACY_INBOX=privacy@firstpitch.app

# ── Optional ─────────────────────────────────────────────────────────────────
# AI (coach chat, intent search). Falls back to MockProvider when unset.
OPENAI_API_KEY=

# Error monitoring (set ONE to enable remote reporting).
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# Billing (off until STRIPE_SECRET_KEY is set). Price IDs per plan.
STRIPE_SECRET_KEY=
STRIPE_PRICE_COACH=
STRIPE_PRICE_MULTI=
STRIPE_PRICE_CLUB=

# Privacy-friendly analytics (Plausible-compatible). Off unless domain is set.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Affiliate tag for gear buy-links.
NEXT_PUBLIC_AFFILIATE_AMAZON_TAG=firstpitch-20