{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstpitch.app/schemas/competitor-research/corpus-item.json",
  "title": "Competitor Research Corpus Item",
  "description": "One unit of competitor/market-research signal. Built around workflows, not raw reviews. See competitor-research-corpus-plan.md (\u00a74).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_type",
    "platform_name",
    "platform_category",
    "source_platform",
    "url",
    "date_collected",
    "clean_text",
    "author_role_inferred",
    "age_band",
    "sport",
    "sentiment",
    "confidence"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "description": "Stable unique id (uuid or slug). Used for de-duplication."
    },
    "source_type": {
      "type": "string",
      "enum": ["app_review", "reddit", "forum", "product_page", "help_doc", "release_note", "youtube", "social", "pricing_page", "manual_note"]
    },
    "platform_name": {
      "type": "string",
      "description": "Canonical platform name; should match an id/name in platforms.json when possible."
    },
    "platform_category": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["lineup", "scorekeeping", "stats", "team_management", "practice_planning", "training", "video_analysis", "hardware_metrics", "recruiting", "club_ops"]
      }
    },
    "source_platform": {
      "type": "string",
      "enum": ["apple_app_store", "google_play", "reddit", "web", "youtube", "facebook", "product_site"]
    },
    "url": {
      "type": "string",
      "description": "Provenance URL with tracking params stripped. May be an internal:// reference for manual notes derived from our own research docs."
    },
    "date_published": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_collected": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "app_version": { "type": ["string", "null"] },
    "rating": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "review_title": { "type": ["string", "null"] },
    "raw_text": {
      "type": ["string", "null"],
      "description": "Optional and minimal. Do NOT warehouse long verbatim copyrighted review text \u2014 prefer paraphrase in clean_text."
    },
    "clean_text": {
      "type": "string",
      "description": "Paraphrased insight. This is the field the engine reasons over."
    },
    "author_role_inferred": {
      "type": "string",
      "enum": ["coach", "parent", "player", "scorer", "trainer", "facility_owner", "tournament_director", "unknown"]
    },
    "age_band": {
      "type": "string",
      "enum": ["tee_ball", "8U", "10U", "12U", "14U", "HS", "college", "adult", "unknown"]
    },
    "sport": {
      "type": "string",
      "enum": ["baseball", "softball", "both", "unknown"]
    },
    "workflow_stage": {
      "type": ["string", "null"],
      "enum": ["pre_game", "game_day", "post_game", "practice", "off_season", "tryout", "tournament", "recruiting", null]
    },
    "job_to_be_done": { "type": "array", "items": { "type": "string" } },
    "pain_points": { "type": "array", "items": { "type": "string" } },
    "feature_requests": { "type": "array", "items": { "type": "string" } },
    "delighters": { "type": "array", "items": { "type": "string" } },
    "bugs_or_reliability_issues": { "type": "array", "items": { "type": "string" } },
    "workarounds": { "type": "array", "items": { "type": "string" } },
    "competitors_mentioned": { "type": "array", "items": { "type": "string" } },
    "pricing_feedback": { "type": "array", "items": { "type": "string" } },
    "trust_or_safety_concerns": { "type": "array", "items": { "type": "string" } },
    "data_ownership_concerns": { "type": "array", "items": { "type": "string" } },
    "export_or_integration_needs": { "type": "array", "items": { "type": "string" } },
    "sentiment": {
      "type": "string",
      "enum": ["positive", "neutral", "negative", "mixed"]
    },
    "urgency": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null]
    },
    "severity": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", null]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "product_implication": { "type": ["string", "null"] },
    "opportunity_score": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 40,
      "description": "Sum of the eight scoring dimensions (\u00a77). >= 32 => MVP consideration."
    }
  }
}
